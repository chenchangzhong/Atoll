    "Displays a HUD notification when Bluetooth audio devices (headphones, AirPods, speakers) connect, showing device name and battery level.": {
      "comment": "A footer for the \"Bluetooth Audio Devices\" section in the HUD settings.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une notification sur l’ATH lorsque des appareils audio Bluetooth (Écouteurs, AirPods, enceintes) se connectent, et affiche le nom et la charge de la batterie de celui-ci."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 오디오 기기(헤드폰, AirPods, 스피커)가 연결되면 기기 이름과 배터리 잔량을 보여주는 HUD 알림을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft een HUD-melding weer wanneer Bluetooth-audioapparaten (hoofdtelefoon, AirPods, luidsprekers) verbinding maken, waarbij de apparaatnaam en het batterijniveau worden weergegeven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe uma notificação HUD quando os dispositivos de áudio Bluetooth (fones de ouvido, AirPods, alto-falantes) se conectam, mostrando o nome do dispositivo e o nível da bateria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стиль дисплея"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงการแจ้งเตือน HUD เมื่ออุปกรณ์เสียงบลูทูธ (หูฟัง, AirPods, ลำโพง) เชื่อมต่อ แสดงชื่ออุปกรณ์และระดับแบตเตอรี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth ses aygıtları (kulaklık, AirPods, hoparlörler) bağlandığında aygıt adını ve pil seviyesini gösteren bir HUD bildirimi görüntüler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙音频设备（耳机、AirPods、扬声器）连接时显示 HUD 通知，包含设备名称和电池电量。"
          }
        }
      }
    },
    "Displays play/pause and skip buttons beside the notch while music is active. Disabled by default.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악이 재생 중일 때 노치 옆에 재생/일시 정지 및 건너뛰기 버튼을 표시합니다. 이 기능은 기본적으로 비활성화되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont knoppen voor afspelen/pauzeren en overslaan naast de inkeping terwijl de muziek actief is. Standaard uitgeschakeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe os botões de reprodução/pausa e pular ao lado do notch enquanto a música está ativa. Desativado por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображает кнопки \"Воспроизведение/Пауза\" и \"Вперед\" рядом с вырезом при активной музыке. Отключено по умолчанию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงปุ่มเล่น/หยุดและข้ามข้างรอยบากขณะเพลงทำงาน ปิดใช้โดยค่าเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik etkinken çentiğin yanında oynat/duraklat ve atla düğmelerini görüntüler. Varsayılan olarak devre dışı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐播放时在刘海旁边显示播放/暂停和跳过按钮。默认禁用。"
          }
        }
      }
    },
