    "Only applies when Material is set to Frosted Glass.": {
      "comment": "A description of the media panel blur setting, visible only when Material is set to Frosted Glass. | A description of the media panel blur setting, visible only when Material is set to Frosted Glass. | merge:ko:alt='‘Material’이 ‘Frosted Glass’로 설정된 경우에만 적용됩니다.'",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Material’이 '프로스티드 글래스'로 설정된 경우에만 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt alleen als Materiaal is ingesteld op Matglas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só se aplica quando o Material é definido para Vidro Fosco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется только если выбран материал «Матовое стекло»."
