    "Recommended minimum width adjusts automatically based on the number of enabled tabs.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 탭 수에 따라 권장 최소 너비가 자동으로 조절됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanbevolen minimale breedte wordt automatisch aangepast op basis van het aantal ingeschakelde tabbladen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуемая минимальная ширина определяется автоматически по числу включённых вкладок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความกว้างขั้นต่ำที่แนะนำปรับอัตโนมัติตามจำนวนแท็บที่เปิดใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilen minimum genişlik, etkin sekme sayısına göre otomatik olarak ayarlanır."
          }
        },
        "zh-Hans": {
