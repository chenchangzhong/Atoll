          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте элементы между слотами или сбрасывайте их с палитры для изменения управления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากรายการระหว่างช่องหรือวางจากจานสีเพื่อจัดเรียงปุ่มควบคุมใหม่"
          }
