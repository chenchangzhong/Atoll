    "Enable to route BetterDisplay or Lunar display adjustments through Atoll's active HUD style.": {
      "comment": "A description of the feature that allows third-party display integrations to be enabled. | A description of the feature that allows third-party display integrations to be enabled. | merge:ko:alt='BetterDisplay 또는 Lunar의 디스플레이 조절 사항이 Atoll의 활성 HUD 스타일을 통해 표시되도록 활성화합니다.'",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BetterDisplay 또는 Lunar의 디스플레이 조정을 Atoll의 활성 HUD 스타일로 연결하려면 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel in om BetterDisplay- of Lunar-weergaveaanpassingen via de actieve HUD-stijl van Atoll te routeren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрутизировать изменения дисплея через Atoll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้เพื่อส่งการปรับจอ BetterDisplay หรือ Lunar ผ่านสไตล์ HUD ที่ใช้งานของ Atoll"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BetterDisplay veya Lunar ekran ayarlarını Atoll'un etkin HUD stili üzerinden yönlendirmek için etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后通过 Atoll 的活跃 HUD 样式传递 BetterDisplay 或 Lunar 的显示调整。"
          }
        }
      }
    },
    "Enable when scaling beyond 30x20px so the Atoll opens gracefully.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30x20px 이상으로 확대할 때 Atoll이 자연스럽게 열리도록 활성화합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inschakelen bij schalen voorbij 30x20px, zodat het Atoll netjes wordt geopend."
