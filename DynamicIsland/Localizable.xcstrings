    "Labels are forced to compact on/off text while brief toast mode is enabled.": {
      "comment": "A help text explaining why the \"Show Focus Label\" toggle is disabled when the \"Show Focus as brief toast\" toggle is enabled.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'간소화된 토스트 모드'가 활성화되어 있는 동안에는 레이블이 '켬/끔' 텍스트로 축소되어 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketten worden gedwongen om aan/uit-tekst te comprimeren terwijl de modus voor kort toasten is ingeschakeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os rótulos são forçados a compactar o texto ligado/desligado enquanto o modo brief toast está ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст уплотнён до вкл/выкл, пока работает режим кратких уведомлений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้ายกำกับจะถูกบังคับให้แสดงข้อความ เปิด/ปิด แบบสั้นเมื่อเปิดใช้โหมด toast สั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa kızartma modu etkinleştirildiğinde, etiketler açık/kapalı metni sıkıştırmaya zorlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用简短提示模式时，标签将强制为紧凑开/关文本。"
          }
        }
      }
    },
