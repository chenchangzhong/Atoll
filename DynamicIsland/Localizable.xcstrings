        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ได้เฉพาะเมื่อวัสดุตั้งเป็น Frosted Glass"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Malzeme Buzlu Cam olarak ayarlandığında geçerlidir."
