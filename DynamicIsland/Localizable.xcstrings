    "Your camera is never used without your consent, and nothing is recorded or stored.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 동의 없이는 카메라를 절대로 사용하지 않으며, 어떠한 내용도 녹화하거나 저장하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je camera wordt nooit zonder je toestemming gebruikt en er wordt niets opgenomen of opgeslagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua câmera nunca é usada sem o seu consentimento, e nada é gravado ou armazenado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша камера не используется без согласия, ничего не записывается и не сохраняется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้องของคุณไม่ถูกใช้โดยไม่ได้รับความยินยอม และไม่มีอะไรถูกบันทึกหรือจัดเก็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranız asla sizin izniniz olmadan kullanılmaz, hiçbir şey kaydedilmez veya saklanmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经您同意，相机不会被使用，且不会录制或存储任何内容。"
          }
        }
      }
    },
    "Your support funds software development learning for students in 9th–12th grade.": {
      "comment": "A footer note explaining the app's funding.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 후원금은 9~12학년 학생들의 소프트웨어 개발 교육을 지원하는 데 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw steun financiert het leren van softwareontwikkeling voor leerlingen in de 9e tot en met de 12e klas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша поддержка финансирует обучение студентов программированию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนับสนุนของคุณเป็นทุนการเรียนรู้การพัฒนาซอฟต์แวร์สำหรับนักเรียนชั้น ม.3–ม.6"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteğiniz, 9-12. sınıftaki öğrencilerin yazılım geliştirme öğrenimini finanse ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的支持将资助高中生的软件开发学习。"
          }
        }
      }
    },
