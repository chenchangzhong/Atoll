          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это необязательно. Вы сможете изменить это позже из строки меню."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่เป็นตัวเลือก คุณสามารถเปลี่ยนได้ทุกเมื่อจากแถบเมนู"
          }
        },
        "tr": {
