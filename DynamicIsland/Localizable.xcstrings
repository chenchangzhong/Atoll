    "Monitor your Downloads folder for Chromium-style downloads (.crdownload files) and show a live activity in the Dynamic Island while downloads are in progress.": {
      "comment": "A footer description for the \"Downloads\" section of the settings view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 폴더에서 크로미움 스타일의 다운로드(.crdownload 파일)를 감지하고, 다운로드가 진행되는 동안 Dynamic Island에 실시간 현황을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je map Downloads op downloads in Chromium-stijl (.crdownload-bestanden) en toon een live activiteit in Dynamic Island terwijl downloads bezig zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitore sua pasta Downloads para downloads no estilo Chromium (arquivos .crdownload) e mostre uma atividade ao vivo na Dynamic Island enquanto os downloads estão em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживает папку загрузок на наличие файлов Chromium (.crdownload) и показывает процесс в Dynamic Island."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบโฟลเดอร์ดาวน์โหลดของคุณสำหรับการดาวน์โหลดสไตล์ Chromium (.crdownload) และแสดงกิจกรรมสดในไดนามิกไอแลนด์ขณะดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromium tarzı indirmeler (.crdownload dosyaları) için İndirilenler klasörünüzü izleyin ve indirmeler devam ederken Dynamic Island'de canlı bir etkinlik gösterin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监控下载文件夹中 Chromium 风格的下载（.crdownload 文件），并在下载进行时在灵动岛中显示实时活动。"
          }
        }
      }
    },
