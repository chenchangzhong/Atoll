    "Spotify often blocks in-app logins. Sign in via your normal browser, then paste sp_dc in Settings.": {
      "comment": "A help message for the Spotify login sheet.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify blokkeert in-app-aanmeldingen vaak. Meld je aan via je normale browser en plak daarna `sp_dc` in Instellingen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify часто блокирует вход из приложений. Войдите через браузер и вставьте sp_dc в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify มักบล็อกการเข้าสู่ระบบในแอป เข้าสู่ระบบผ่านเบราว์เซอร์ปกติ แล้ววาง sp_dc ในการตั้งค่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 经常屏蔽应用内登录。请通过您的常用浏览器登录，然后在设置中粘贴 sp_dc。"
          }
        }
      }
    },
