    "Applies the notch-style parallax effect to the lock screen media widget album art.": {
      "comment": "merge:ko:alt='잠금 화면 미디어 위젯의 앨범 아트에 노치 스타일의 시차 효과를 적용합니다.'",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면 미디어 위젯의 앨범 아트에 노치 스타일의 패럴랙스 효과를 적용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past het parallax-effect in inkepingstijl toe op de albumhoezen van de mediawidget op het vergrendelscherm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica o efeito de paralaxe ao notch à arte do álbum do widget de mídia da tela de bloqueio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เอฟเฟกต์พารัลแลกซ์สไตล์รอยบากกับปกอัลบั้มวิดเจ็ตสื่อบนหน้าจอล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit ekranı medya widget'ının albüm kapağına çentik stili paralaks efektini uygular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将刘海风格的视差效果应用于锁屏媒体小组件的专辑封面。"
          }
        }
      }
    },
    "Are you sure you want to delete \"%@\"?": {
      "comment": "A confirmation prompt asking the user to confirm the deletion of a custom idle animation. The placeholder text inside the quotation marks should be replaced with the name of the animation.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer \"%@\" ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"을(를) 삭제하시겠습니까?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"을(를) 삭제하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je \"%@\" wilt verwijderen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir “%@”?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AQI"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete \"%@\"?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"yi silmek istediğinizden emin misiniz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要删除「%@」吗？"
          }
        }
      }
    },
    "Atoll": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll"
          }
        }
      },
      "shouldTranslate": false
    },
    "Atoll always listens to selected-provider brightness events, and listens to provider volume events only when external volume listener is enabled.": {
      "comment": "A footer text that explains the behavior of the third-party DDC integration settings. | A footer text that explains the behavior of the third-party DDC integration settings. | merge:ko:alt='Atoll은 항상 선택한 제공자의 밝기 이벤트를 수신하며, 외부 음량 감지가 활성화된 경우에만 제공자의 음량 이벤트를 수신합니다.'",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll은 항상 선택된 제공업체의 밝기 이벤트를 감지하며, 외부 음량 감지 기능이 활성화된 경우에만 제공업체의 음량 이벤트를 감지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll luistert altijd naar helderheidsgebeurtenissen van de geselecteerde provider en luistert alleen naar volumegebeurtenissen van de provider als de externe volumelistener is ingeschakeld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll отслеживает яркость от выбранного провайдера, а громкость — только при внешнем контроле."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll รับฟังเหตุการณ์ความสว่างจากผู้ให้บริการที่เลือกเสมอ และรับฟังเหตุการณ์ระดับเสียงเมื่อเปิดใช้ตัวรับฟังระดับเสียงภายนอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll, seçili sağlayıcının parlaklık olaylarını her zaman dinler; sağlayıcı ses düzeyi olaylarını ise yalnızca harici ses düzeyi dinleyicisi etkinken dinler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll 始终监听所选提供商的亮度事件，仅在启用外部音量监听器时监听提供商的音量事件。"
          }
        }
      }
    },
    "Atoll includes a mirror feature that lets you quickly check your appearance using your camera, right from the notch. Camera access is required only to show this live preview. You can turn the mirror feature on or off at any time in the app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll에는 노치에서 바로 카메라를 통해 외모를 빠르게 확인할 수 있는 거울 기능이 포함되어 있습니다. 카메라 접근 권한은 이 실시간 미리보기를 표시하는 용도로만 사용됩니다. 거울 기능은 앱 설정에서 언제든지 켜거나 끌 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll bevat een spiegelfunctie waarmee je snel je uiterlijk kunt controleren met je camera, direct vanaf de inkeping. Cameratoegang is alleen nodig om deze live preview te tonen. Je kunt de spiegelfunctie op elk moment in de app in- of uitschakelen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Atoll possui um recurso de espelho que permite verificar rapidamente sua aparência usando sua câmera, direto do notch. O acesso à câmera é necessário apenas para mostrar esta visualização ao vivo. Você pode ligar ou desligar o recurso de espelho a qualquer momento no aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение к камере нужно для включения функции зеркала в вырезе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll มีฟีเจอร์กระจกเงาที่ให้คุณตรวจสอบลักษณะของคุณโดยใช้กล้อง จากรอยบากได้ทันที สิทธิ์เข้าถึงกล้องต้องใช้เฉพาะเพื่อแสดงตัวอย่างสดนี้ คุณสามารถเปิดหรือปิดฟีเจอร์กระจกเงาได้ทุกเมื่อในแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll, kameranızı kullanarak görünümünüzü doğrudan çentikten hızlıca kontrol etmenizi sağlayan bir ayna özelliği içerir. Kamera erişimi yalnızca bu canlı önizlemeyi göstermek için gereklidir. Ayna özelliğini uygulamada istediğiniz zaman açıp kapatabilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll 包含镜像功能，让您可以直接从刘海处使用相机快速检查外观。相机访问仅用于显示实时预览。您可以随时在应用中开启或关闭镜像功能。"
          }
        }
      }
    },
    "Atoll keeps native volume key interception. External provider volume payloads are ignored while this is off.": {
      "comment": "A description of the behavior of Atoll's volume key interception when the external volume control listener is disabled.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll은 시스템 기본 음량 키 제어 기능을 유지합니다. 이 기능을 끄면 외부 제공업체의 음량 데이터가 무시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll behoudt de onderschepping van de oorspronkelijke volumesleutel. Volumepayloads van externe providers worden genegeerd als dit is uitgeschakeld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внешние данные громкости игнорируются, пока включен системный перехват."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll ยังคงดักจับปุ่มระดับเสียงเดิม ข้อมูลระดับเสียงจากผู้ให้บริการภายนอกจะถูกละเลยเมื่อปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll yerel ses tuşu yakalamayı korur. Bu kapalıyken harici sağlayıcı ses düzeyi verileri yok sayılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll 保持原生音量键拦截。关闭此项时将忽略外部提供商的音量数据。"
          }
        }
      }
    },
    "Atoll uses the local `sp_dc` cookie only to request Spotify's internal web-player token and fetch the matching Canvas for the current track.": {
      "comment": "A description of how the Spotify cookie is used.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll gebruikt de lokale `sp_dc` cookie alleen om Spotify's interne webplayer-token op te vragen en het overeenkomende Canvas voor het huidige nummer op te halen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll использует cookie sp_dc только для получения токена веб-плеера Spotify и загрузки Canvas для текущего трека."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll ใช้คุกกี้ `sp_dc` ในเครื่องเพื่อขอโทเค็น Spotify web-player และดึง Canvas ที่ตรงกันสำหรับแทร็กปัจจุบันเท่านั้น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll 仅使用本地 `sp_dc` cookie 来请求 Spotify 内部的 web-player 令牌，并获取当前曲目匹配的 Canvas。"
          }
        }
      }
    },
    "Atoll's built-in volume key interception is disabled while external volume listening is on. Volume HUD/OSD will follow %@ payloads.": {
      "comment": "A description below the toggle that explains the effect of enabling or disabling the feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 음량 감지 기능이 켜져 있으면 Atoll의 내장 음량 키 제어 기능이 비활성화됩니다. 음량 HUD/OSD는 %@ 데이터를 기준으로 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ingebouwde onderschepping van de volumetoetsen van Atoll is uitgeschakeld terwijl luisteren naar extern volume is ingeschakeld. Volume-HUD/OSD volgt %@ payloads."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенный перехват отключен. HUD/OSD следует данным от %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Atoll's built-in volume key interception is disabled while external volume listening is on. Volume HUD/OSD will follow %@ payloads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harici ses dinleme açıkken Atoll'un yerleşik ses tuşu yakalaması devre dışı bırakılır. Ses HUD/OSD gösterimi %@ verilerini izler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用外部音量监听时，Atoll 的内置音量键拦截已禁用。音量 HUD/OSD 将跟随 %@ 的数据。"
          }
        }
      }
    },
