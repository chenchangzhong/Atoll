    "Select one or more profiles to customize your experience": {
      "comment": "A description below the header that instructs users to select one or more profiles to customize their experience.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملفا شخصيا واحدا أو أكثر لتخصيص تجربتك"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jeden nebo více profilů a přizpůsobte si své prostředí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein oder mehrere Profile aus, um Ihre Erfahrung anzupassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Select one or more profiles to customize your experience"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione uno o más perfiles para personalizar su experiencia"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un ou plusieurs profils pour personnaliser votre expérience"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "hu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg ett eller flere profiler for å tilpasse opplevelsen din"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите один или несколько профилей для настройки"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneyiminizi özelleştirmek için bir veya daha fazla profil seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть один або кілька профілів, щоб налаштувати свій досвід"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个或多个配置文件以自定义您的体验"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโปรไฟล์อย่างน้อยหนึ่งอันเพื่อปรับแต่งประสบการณ์ของคุณ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een of meer profielen om je ervaring aan te passen"
          }
        }
      }
    },
    "Select the music source you want to use. You can change this later in the app settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مصدر الموسيقى الذي تريد استخدامه. يمكنك تغيير هذا لاحقا في إعدادات التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte zdroj hudby, který chcete použít. Toto nastavení můžete později změnit v nastavení aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Musik Quelle aus, die du benutzen willst. Du kannst dies später in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak istediğiniz müzik kaynağını seçin. Bunu daha sonra uygulama ayarlarından değiştirebilirsiniz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez la source de musique que vous souhaitez utiliser. Vous pourrez la modifier plus tard dans les paramètres de l'application."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઉપયોગ કરવા માંગતા સંગીત સ્ત્રોત પસંદ કરો. તમે તેને પછી એપની સેટિંગ્સમાં બદલી શકો છો."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selezionare la sorgente musicale che si desidera utilizzare. È possibile modificare questa impostazione in seguito nelle impostazioni dell'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "음악 소스 선택하세요. 나중에 앱 설정에서 변경 가능합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg musikkilden du vil bruke. Du kan endre dette senere i appinnstillingene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz źródło muzyki, którego chcesz użyć. Możesz to później zmienić w ustawieniach aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Select the music source you want to use. You can change this later in the app settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите источник музыки, который хотите использовать. Вы можете изменить его позже в настройках приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பயன்படுத்த விரும்பும் இசை மூலத்தைத் தேர்ந்தெடுக்கவும். இதை நீங்கள் பின்னர் செயலி அமைப்புகளில் மாற்றலாம்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanmak istediğiniz müzik kaynağını seçin. Bunu daha sonra uygulama ayarlarından değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть власний звук, який буде відтворюватися після закінчення таймера. Підтримувані формати: MP3, M4A, WAV та AIFF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择您想要使用的音乐源。您可以稍后在应用设置中更改此项。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแหล่งเพลงที่คุณต้องการใช้ คุณสามารถเปลี่ยนได้ภายหลังในการตั้งค่าแอป"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer de muziekbron die je wilt gebruiken. Je kunt dit later wijzigen in de app-instellingen."
          }
        }
      }
    },
