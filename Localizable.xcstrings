    "Adjust settings above to see changes in real-time. The actual OSD appears at the bottom center of your screen.": {
      "comment": "A footer in the \"Preview\" section of the Custom OSD settings, explaining how to use the live preview feature.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte výše uvedená nastavení a změny se projeví v reálném čase. Skutečné OSD se zobrazí ve spodní části uprostřed obrazovky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die obigen Einstellungen an, um die Änderungen in Echtzeit zu sehen. Die tatsächliche OSD wird in der unteren Mitte Ihres Bildschirms angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adjust settings above to see changes in real-time. The actual OSD appears at the bottom center of your screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la configuración anterior para ver los cambios en tiempo real. El menú en pantalla real aparece en la parte inferior central de la pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säädä yllä olevia asetuksia nähdäksesi muutokset reaaliajassa. Todellinen OSD näkyy näytön alareunassa keskellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez les paramètres ci-dessus pour voir les modifications en temps réel. L'OSD réel apparaît en bas au centre de votre écran."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વાસ્તવિક સમયે ફેરફારો જોવા માટે ઉપરોક્ત સેટિંગ્સ સમાયોજિત કરો. વાસ્તવિક OSD તમારી સ્ક્રીનના નીચે મધ્યમાં દેખાય છે."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वास्तविक समय में परिवर्तन देखने के लिए उपरोक्त सेटिंग्स समायोजित करें। वास्तविक OSD आपकी स्क्रीन के निचले केंद्र में दिखाई देता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 설정을 조정하면 실시간으로 변경 사항을 확인할 수 있습니다. 실제 OSD는 화면 하단 중앙에 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster innstillingene ovenfor for å se endringene i sanntid. Den faktiske OSD-menyen vises nederst i midten av skjermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте параметры выше. OSD появится внизу по центру."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justera inställningarna ovan för att se ändringarna i realtid. Den faktiska OSD-menyn visas längst ned i mitten av skärmen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri gerçek zamanlı olarak görmek için yukarıdaki ayarları ayarlayın. Gerçek OSD, ekranınızın alt ortasında görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整上方设置即可实时查看变化。实际屏幕显示菜单（OSD）位于屏幕底部中央位置。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับการตั้งค้าด้านบนเพื่อดูการเปลี่ยนแปลงแบบเรียลไทม์ OSD จริงจะแสดงที่กลางด้านล่างของหน้าจอ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de bovenstaande instellingen aan om wijzigingen in realtime te zien. Het daadwerkelijke OSD verschijnt midden onderaan je scherm."
          }
        }
      }
    },
