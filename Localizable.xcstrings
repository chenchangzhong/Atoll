    "Accessibility permission lets Dynamic Island replace the native volume, brightness, and keyboard HUDs.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限允许灵动岛替换原生的音量、亮度和键盘提示框。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ Accessibility ช่วยให้ไดนามิกไอแลนด์แทนที่ HUD ระดับเสียง ความสว่าง และแป้นพิมพ์เดิม"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met toegankelijkheidsrechten kan Dynamic Island het oorspronkelijke volume, de helderheid en de toetsenbord-HUD's vervangen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение «Универсальный доступ» позволяет Dynamic Island заменять системные индикаторы громкости, яркости и клавиатуры."
          }
        }
      }
    },
