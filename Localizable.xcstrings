    "Choose animation to display when Atoll is idle. Tap to select, hold to delete custom animations.": {
      "comment": "A footer label under the section that lists their idle animations.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte animaci, která se zobrazí, když je Atoll nečinný. Klepnutím vyberte, podržením smažte vlastní animace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Animation aus, die angezeigt werden soll, wenn Atoll im Leerlauf ist. Tippen Sie zum Auswählen und halten Sie zum Löschen benutzerdefinierter Animationen gedrückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose animation to display when Atoll is idle. Tap to select, hold to delete custom animations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la animación para que se muestre cuando Atoll esté inactivo. Toque para seleccionar, mantenga presionado para eliminar animaciones personalizadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse animaatio, joka näytetään, kun Atoll on lepotilassa. Napauta valitaksesi, pidä painettuna poistaaksesi mukautetut animaatiot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une animation à afficher lorsque la Atoll est inactive. Touchez pour sélectionner, maintenez pour supprimer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब एटोल निष्क्रिय हो तब दिखाने के लिए एनिमेशन चुनें। कस्टम एनिमेशन चुनने के लिए टैप करें, हटाने के लिए दबाकर रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg animasjon som skal vises når Atoll er inaktiv. Trykk for å velge, hold nede for å slette tilpassede animasjoner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ru": {
          "stringUnit": {
