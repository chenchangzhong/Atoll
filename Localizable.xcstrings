    "Controls whether Dynamic Island mirrors lock/unlock events with its own live activity and audible chimes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم في ما إذا كان Dynamic Island يعكس أحداث القفل/الفتح بنشاطه المباشر وأصواته المسموعة."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кантралюе, ці Дынамічны востраў адлюстроўвае падзеі блакіроўкі/разблакіроўкі з дапамогай уласнай ажыўленай актыўнасці і гучных сігналаў."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládá, zda Dynamic Island zrcadlí události zamykání/odemykání vlastní živou aktivitou a zvukovými signály."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, ob Dynamic Island Sperr-/Entsperrereignisse mit eigener Live-Aktivität und hörbaren Glockenspielen spiegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controls whether Dynamic Island mirrors lock/unlock events with its own live activity and audible chimes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla si Dynamic Island refleja eventos de bloqueo/desbloqueo con su propia actividad en vivo y campanadas audibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa, peilaako Dynamic Island lukitus-/lukituksen avaustapahtumat omalla reaaliaikaisella toiminnallaan ja äänimerkeillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle si Dynamic Island reflète les événements de verrouillage/déverrouillage avec sa propre activité en direct et des carillons audibles."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नियंत्रित करता है कि डायनामिक आइलैंड अपनी लाइव गतिविधि और श्रव्य घंटियों के साथ लॉक/अनलॉक घटनाओं को प्रतिबिंबित करे या नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja, hogy a Dynamic Island tükrözze-e a zárolási/feloldási eseményeket saját élő tevékenységével és hangjelzésekkel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다이내믹 아일랜드가 잠금/잠금 해제 이벤트를 자체 라이브 액티비티 및 청각적 알림음으로 동기화하는지 여부를 제어합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerer om Dynamic Island speiler låse-/låse opp-hendelser med sin egen liveaktivitet og hørbare signaler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляет тем, дублирует ли Dynamic Island системные события блокировки/разблокировки своими Live Activity и звуками."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr om Dynamic Island speglar låsnings-/upplåsningshändelser med sin egen liveaktivitet och hörbara signaler."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டைனமிக் ஐலேண்ட், அதன் சொந்த நேரடிச் செயல்பாடு மற்றும் கேட்கக்கூடிய ஒலிக் குறிப்புகளுடன் பூட்டு/திறக்கும் நிகழ்வுகளைப் பிரதிபலிக்கிறதா இல்லையா என்பதைக் கட்டுப்படுத்துகிறது."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island'ın kendi canlı etkinliği ve sesli çanları ile kilitleme/kilit açma olaylarını yansıtıp yansıtmadığını kontrol eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制灵动岛是否通过自身的实时活动和提示音来响应锁屏/解锁事件。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมว่าไดนามิกไอแลนด์จะสะท้อนเหตุการณ์ล็อก/ปลดล็อกด้วยกิจกรรมสดและเสียงของตัวเองหรือไม่"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt of Dynamic Island vergrendelings- en ontgrendelingsgebeurtenissen weergeeft via zijn eigen live-activiteit en geluidssignalen."
          }
        }
      }
    },
