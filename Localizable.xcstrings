    "Unlock advanced features and improve your experience. Upgrade now for more customizations!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte erweiterte Funktionen frei und verbessere deine Erfahrung. Upgrade jetzt für weitere Anpassungsmöglichkeiten!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea funciones avanzadas y mejora tu experiencia. ¡Actualiza ahora para más personalizaciones!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez des fonctionnalités avancées et améliorez votre expérience. Mettez à niveau maintenant pour plus de personnalisations !"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sblocca le funzionalità avanzate e migliora la tua esperienza. Aggiorna ora per ulteriori personalizzazioni!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "고급 설정을 해제해 경험을 향상하세요. 더 많은 맞춤화 설정을 지금 바로 업그레이드해서 즐기세요!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp avanserte funksjoner og forbedre opplevelsen din. Oppgrader nå for flere tilpasningsmuligheter!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odblokuj dodatkowe funkcje i ciesz się lepszymi możliwościami. Ulepsz teraz, aby móc bardziej dostosować ustawienia!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте расширенные функции и улучшите свой опыт. Обновитесь для дополнительных настроек!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேம்பட்ட அம்சங்களைத் திறந்து உங்கள் அனுபவத்தை மேம்படுத்துங்கள். மேலும் தனிப்பயனாக்கல்களுக்கு இப்போதே மேம்படுத்துங்கள்!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте розширені функції та покращіть свій досвід. Оновіть зараз, щоб отримати більше можливостей для налаштування!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "解锁高级功能并提升您的体验。现在升级以获取更多自定义功能！"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อกฟีเจอร์ขั้นสูงและปรับปรุงประสบการณ์ อัปเกรดเลยเพื่อการปรับแต่งเพิ่มเติม!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel geavanceerde functies en verbeter je ervaring. Upgrade nu voor meer aanpassingen!"
          }
        }
      }
    },
